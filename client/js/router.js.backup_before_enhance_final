        content.innerHTML = `<div style="color: var(--danger-red); padding: 2rem; text-align: center; background: var(--white); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);">Gagal memuat dasbor: ${error.message}</div>`;
