# ==============================================================================
# BANK SAMPAH DIGITAL - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3000
APP_NAME="Bank Sampah Digital"
APP_URL=http://localhost:3000

# Database Configuration
# Supported: sqlite | mysql
DB_CONNECTION=sqlite

# SQLite settings (default zero-config)
DB_SQLITE_FILENAME=./data/banksampah.sqlite

# MySQL settings (Laragon / Production)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bank_sampah_digital
DB_USERNAME=root
DB_PASSWORD=

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_banksampah_change_in_production_!2026#
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Multi-Branch Settings (MVP operates in single-branch mode)
DEFAULT_BRANCH_CODE=BS-PUSAT-01
DEFAULT_BRANCH_NAME="Bank Sampah Digital Pusat"

# Logging Level: debug | info | warn | error
LOG_LEVEL=info

# Nous Research AI Configuration
# Salin dari dashboard Nous Research Inference API. JANGAN commit nilai asli.
NOUS_API_KEY=
NOUS_KEY_ID=
NOUS_API_BASE_URL=https://inference-api.nousresearch.com/v1
NOUS_MODEL=meituan/longcat-2.5-preview:free

# ==============================================================================
# WHATSAPP NOTIFICATION CONFIGURATION
# Provider resmi yang didukung: meta (WhatsApp Business Platform / Cloud API),
# twilio, fonnte, wablas. Gunakan 'none' untuk mode lokal (tidak mengirim pesan
# nyata) dan 'mock' untuk pengujian lokal dengan status MOCK_LOGGED.
# ==============================================================================
WHATSAPP_PROVIDER=none

# --- Meta WhatsApp Business Platform (Cloud API) — rekomendasi resmi ---
# WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Token verifikasi webhook yang Anda daftarkan di Meta App Dashboard
WHATSAPP_VERIFY_TOKEN=
# App Secret untuk validasi signature X-Hub-Signature-256 (wajib di production)
WHATSAPP_APP_SECRET=
# Set true jika akun hanya boleh mengirim template yang sudah disetujui Meta
WHATSAPP_REQUIRE_TEMPLATE=false

# --- Gateway lain (opsional, hanya jika sudah punya akun resmi) ---
WHATSAPP_API_KEY=
WHATSAPP_API_SECRET=
WHATSAPP_SENDER_NUMBER=
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=

